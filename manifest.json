{
  "manifest_version": 3,
  "name": "Incognito+ MVP",
  "version": "0.1",
  "permissions": [
    "history",
    "storage",
    "tabs",
    "unlimitedStorage",
    "scripting",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}